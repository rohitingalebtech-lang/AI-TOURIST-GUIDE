# .env.example
# Copy this file to .env and customize for your deployment environment

# Flask Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
FLASK_DEBUG=0
PORT=5000

# Optional: Google Gemini API Key for dynamic LLM generation
# If left blank, the application uses its built-in rule and domain knowledge engine
GEMINI_API_KEY=
